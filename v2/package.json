{
  "name": "binaural",
  "version": "2.2.1",
  "description": "Binaural beat, tone, and pattern generator on the Web Audio API",
  "private": true,
  "scripts": {
    "build": "node build.js",
    "build:prod": "NODE_ENV=production node build.js",
    "deploy": "node build.js --deploy",
    "test": "node --test test/*.test.js",
    "check": "npm test && npm run deploy && git -C .. diff --exit-code --stat -- index.html v2/dist/index.html",
    "test:browser": "node browser-tests/smoke.mjs",
    "browsers:chromium": "sh browser-tests/setup.sh --chromium",
    "browsers:setup": "sh browser-tests/setup.sh"
  },
  "devDependencies": {
    "cssnano": "^5.1.15",
    "postcss": "^8.4.24",
    "terser": "^5.17.7"
  }
}
